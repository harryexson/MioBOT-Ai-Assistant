# Server-side only. Add real values to Vercel Environment Variables; never commit .env.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:5173
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:5173,mioai://

# Email verification and password-reset mail use Resend. Keep verification off
# until a verified sender domain and these server-side values are configured.
EMAIL_VERIFICATION_REQUIRED=false
RESEND_API_KEY=
EMAIL_FROM=Mio <no-reply@example.com>

# Optional public build switch; set false only to disable account UI.
VITE_AUTH_ENABLED=false
