# Current backend services. Put real secrets in Vercel Environment Variables
# or an ignored local .env.local file. Never commit real credentials.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:5173
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:5173,mioai://

# Email verification and password-reset mail use Resend. Keep verification off
# until a verified sender domain and these server-side values are configured.
EMAIL_VERIFICATION_REQUIRED=false
RESEND_API_KEY=re_replace_with_resend_api_key
EMAIL_FROM=Mio <no-reply@your-verified-domain.com>

# Optional public build switch; set false only to disable account UI.
VITE_AUTH_ENABLED=false

# Server-side AI provider; compatible gateways can override URL and model.
OPENAI_API_KEY=sk-replace_with_openai_api_key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
AI_REQUESTS_PER_HOUR=60

# Mobile app: public URL only. Never put server credentials in EXPO_PUBLIC_*.
EXPO_PUBLIC_API_URL=https://your-vercel-preview-or-production-domain

# Planned integrations (placeholders only; these are not yet wired to live
# provider APIs in the app). Add only the providers you actually implement.
STRIPE_SECRET_KEY=sk_test_replace_with_stripe_secret
STRIPE_WEBHOOK_SECRET=whsec_replace_with_stripe_webhook_secret
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_replace_with_stripe_publishable_key
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_with_stripe_publishable_key
AMADEUS_CLIENT_ID=replace_with_amadeus_test_client_id
AMADEUS_CLIENT_SECRET=replace_with_amadeus_test_client_secret
TICKETMASTER_API_KEY=replace_with_ticketmaster_api_key
EVENTBRITE_PRIVATE_TOKEN=replace_with_eventbrite_private_token
GOOGLE_MAPS_API_KEY=replace_with_restricted_google_maps_key
RAPIDAPI_KEY=replace_with_rapidapi_key
AMAZON_ACCESS_KEY_ID=replace_with_amazon_associates_access_key
AMAZON_SECRET_ACCESS_KEY=replace_with_amazon_associates_secret
AMAZON_PARTNER_TAG=replace_with_amazon_associates_tag
CJ_API_TOKEN=replace_with_cj_affiliate_api_token
RAKUTEN_API_TOKEN=replace_with_rakuten_advertising_token
