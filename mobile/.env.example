# ── Active native app backend ────────────────────────────────────────────
# Public PocketBase server URL; never put admin credentials or API secrets here.
EXPO_PUBLIC_POCKETBASE_URL=https://pb-mzj62.aibuilder.ionos.com

# ── Legacy integration placeholders (not used by the active app) ─────────
# Stripe requires a server-side payment flow before production checkout.
# Get from https://dashboard.stripe.com/apikeys
# Use the PUBLISHABLE key only — never the secret key in mobile code
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key-here

# ── Mio AI Backend ────────────────────────────────────────────────────────
# Your deployed Mio API server base URL
EXPO_PUBLIC_API_BASE_URL=https://api.mioai.app/v1

# ── OpenAI / Mio AI Engine ────────────────────────────────────────────────
# Backend only — never put your OpenAI secret key here
# The mobile app talks to your own API, which calls OpenAI server-side

# ── Hotel Aggregator (Amadeus) ────────────────────────────────────────────
# Sign up at https://developers.amadeus.com — free sandbox available
EXPO_PUBLIC_AMADEUS_CLIENT_ID=your-amadeus-client-id

# ── Flight Search ─────────────────────────────────────────────────────────
# Aviationstack or Amadeus Flight Offers Search
EXPO_PUBLIC_FLIGHTS_API_KEY=your-flights-api-key

# ── Food Delivery ─────────────────────────────────────────────────────────
# Yelp Fusion API for restaurant search
EXPO_PUBLIC_YELP_API_KEY=your-yelp-api-key

# ── Grocery / Retail ─────────────────────────────────────────────────────
# Kroger API or Open Food Facts for grocery data
EXPO_PUBLIC_GROCERY_API_KEY=your-grocery-api-key

# ── Google Maps (for location-aware search) ───────────────────────────────
EXPO_PUBLIC_GOOGLE_MAPS_KEY=your-google-maps-key
